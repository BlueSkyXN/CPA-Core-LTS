{
  "upstream": "bigmodel",
  "account_scope": "local-account",
  "credential": { "api_key_env": "CP_API_KEY" },
  "identity": {
    "device_id_env": "CP_DEVICE_ID",
    "platform": "<MANUAL_PLATFORM>",
    "os_category": "<MANUAL_OS_CATEGORY>",
    "os_version": "<MANUAL_OS_VERSION>",
    "language": "<MANUAL_LANGUAGE>",
    "timezone": "<MANUAL_TIMEZONE>"
  },
  "models": ["<EXPLICIT_MODEL_ID>"],
  "model_limits": {},
  "max_inflight": 2,
  "host_logging_disabled": false,
  "prompt": {
    "mode": "preserve",
    "allow_request_override": false,
    "templates": {}
  }
}
