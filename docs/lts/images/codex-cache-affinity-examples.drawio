        <mxCell id="title" value="修复前后：四个可观察的例子" style="rounded=0;whiteSpace=none;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=32;fontColor=#0f172a;fontStyle=1;align=left;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="24" width="1030" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="例 1：原有适配缺口；例 2–4：本次索引接入时修正的边界。" style="rounded=0;whiteSpace=none;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#475569;fontStyle=0;align=left;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="82" width="1030" height="55" />
        </mxCell>
        <mxCell id="before-label" value="之前的问题 / 接入反例" style="rounded=0;whiteSpace=none;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=24;fontColor=#9a3412;fontStyle=1;align=left;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="148" width="480" height="40" />
        </mxCell>
        <mxCell id="after-label" value="当前解法与已验证效果" style="rounded=0;whiteSpace=none;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=24;fontColor=#065f46;fontStyle=1;align=left;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="148" width="480" height="40" />
        </mxCell>
        <mxCell id="row0" value="1 · 同一调用方、同一 XSID，缺少其他有效映射" style="rounded=0;whiteSpace=none;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=24;fontColor=#0f172a;fontStyle=1;align=left;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="215" width="1030" height="45" />
        </mxCell>
        <mxCell id="b0" value="XSID 已传入，但未接通出站身份&#10;第 1 轮：H = UUID₁&#10;第 2 轮：H = UUID₂" style="rounded=1;whiteSpace=none;html=0;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#9a3412;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="278" width="480" height="160" />
        </mxCell>
        <mxCell id="a0" value="CallerScope + 合格 XSID → 确定性 H&#10;第 1 轮：H = U；第 2 轮：H = U&#10;仅补 H，缺失的 K 不自动增加" style="rounded=1;whiteSpace=none;html=0;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#065f46;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="278" width="480" height="160" />
        </mxCell>
        <mxCell id="arrow0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#64748b;endArrow=block;endFill=1;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=19;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b0" target="a0">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="row1" value="2 · WS 复用：拟用头不等于实际握手头" style="rounded=0;whiteSpace=none;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=24;fontColor=#0f172a;fontStyle=1;align=left;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="490" width="1030" height="45" />
        </mxCell>
        <mxCell id="b1" value="旧连接实际握手：H1&#10;本轮拟用：H2（正文还可能 K = H2）&#10;索引却按未获握手支持的 H2 发布" style="rounded=1;whiteSpace=none;html=0;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#9a3412;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="553" width="480" height="160" />
        </mxCell>
        <mxCell id="a1" value="按连接 generation 核对实际握手 H&#10;不一致 → 禁止本次新增轨迹 / 绑定&#10;保留交付、冻结字段及已有绑定" style="rounded=1;whiteSpace=none;html=0;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#065f46;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="553" width="480" height="160" />
        </mxCell>
        <mxCell id="arrow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#64748b;endArrow=block;endFill=1;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=19;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="a1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="row2" value="3 · 正文规范化：索引要看最终发送的内容" style="rounded=0;whiteSpace=none;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=24;fontColor=#0f172a;fontStyle=1;align=left;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="765" width="1030" height="45" />
        </mxCell>
        <mxCell id="b2" value="先计算摘要：item.id = a&#10;再执行 ID 规范化：a → msg_a&#10;索引内容与最终出站内容不一致" style="rounded=1;whiteSpace=none;html=0;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#9a3412;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="828" width="480" height="160" />
        </mxCell>
        <mxCell id="a2" value="先规范化：a → msg_a&#10;再计算摘要，再发送&#10;HTTP / WS / 流式 WS 的口径一致" style="rounded=1;whiteSpace=none;html=0;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#065f46;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="828" width="480" height="160" />
        </mxCell>
        <mxCell id="arrow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#64748b;endArrow=block;endFill=1;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=19;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="a2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="row3" value="4 · 请求回收：一次尝试结束不等于整次请求结束" style="rounded=0;whiteSpace=none;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=24;fontColor=#0f172a;fontStyle=1;align=left;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1040" width="1030" height="45" />
        </mxCell>
        <mxCell id="b3" value="4096 次请求已结束，冻结记录仍保留&#10;第 4097 次在前缀检索前触发容量回退&#10;即使索引中存在唯一合格候选" style="rounded=1;whiteSpace=none;html=0;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#9a3412;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1103" width="480" height="160" />
        </mxCell>
        <mxCell id="a3" value="整次请求结束 + 无活跃引用 → 可回收&#10;第 4097 次仍可采用已有合格候选&#10;重试、并行 lane、bootstrap 继续冻结 H/K" style="rounded=1;whiteSpace=none;html=0;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#065f46;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="1103" width="480" height="160" />
        </mxCell>
        <mxCell id="arrow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=2;strokeColor=#64748b;endArrow=block;endFill=1;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=19;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="a3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="这些测试证明代理侧行为已修正；尚未测定上游缓存命中率、延迟或费用收益。" style="rounded=1;whiteSpace=none;html=0;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=21;fontColor=#475569;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1330" width="1030" height="65" />
        </mxCell>
      </root>
