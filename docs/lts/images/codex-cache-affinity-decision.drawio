        <mxCell id="identity" value="保留已有健康映射，或补齐可靠身份&#10;合格 XSID + CallerScope → 稳定 H&#10;新增补齐不自动增加缺失的 K" style="rounded=1;whiteSpace=none;html=0;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=20;fontColor=#172554;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
