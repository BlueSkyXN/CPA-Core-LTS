        <mxCell id="preserve" value="保留对应字段及覆盖规则&#10;H 与 K 分别保存&#10;前缀结果不覆盖明确选择" style="rounded=1;whiteSpace=none;html=0;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=Helvetica,PingFang SC,Microsoft YaHei,sans-serif;fontSize=22;fontColor=#065f46;fontStyle=0;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1">
